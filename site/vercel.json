{
  "cleanUrls": true,
  "redirects": [
    { "source": "/horas", "has": [{ "type": "query", "key": "week", "value": "(?<week>\\d{4}-W\\d{2})" }], "destination": "/admin?week=:week#horas", "permanent": false },
    { "source": "/horas", "destination": "/admin#horas", "permanent": false },
    { "source": "/horas.html", "has": [{ "type": "query", "key": "week", "value": "(?<week>\\d{4}-W\\d{2})" }], "destination": "/admin?week=:week#horas", "permanent": false },
    { "source": "/horas.html", "destination": "/admin#horas", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/timelog", "destination": "https://n8n.nerdrico.com.br/webhook/dcti-timelog" },
    { "source": "/api/timelog-public", "destination": "https://n8n.nerdrico.com.br/webhook/dcti-timelog?public=1" },
    { "source": "/api/admin-meeting", "destination": "https://n8n.nerdrico.com.br/webhook/dcti-admin-meeting" },
    { "source": "/api/admin", "destination": "https://n8n.nerdrico.com.br/webhook/dcti-admin" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
